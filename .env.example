PORT=8091

ENABLE_SWAGGER=true
JWT_ACCESS_SECRET=changeme-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=changeme-refresh-secret-minimum-32-chars-long
PG_USER=admin
PG_PASSWORD=admin
PG_DBNAME=attendance
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=attendance
# docker-compose maps postgres to host port 5433 (5432 stays free for hang-neak-api)
DB_PORT=5433

# Telegram bot (create via @BotFather). Per-parent chat ids come from
# linked ParentLink records, not from an env var.
TELEGRAM_BOT_TOKEN=
